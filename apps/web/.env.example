NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Server-only, read at runtime: where this server reaches the API when that is
# not NEXT_PUBLIC_API_URL (the Docker setup uses http://api:4000). Unset = use
# NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=

# Web Push public key for browser notifications. MUST be byte-identical to the
# API's VAPID_PUBLIC_KEY (see root .env.example). NEXT_PUBLIC_* is inlined at
# BUILD time, so this has to be present here when `next build` runs - setting it
# only in the API/root env or the runtime env will NOT reach the browser bundle.
# Leave blank to disable closed-tab push; in-app/foreground call banners still
# work without it (they only need the service worker, which now registers
# regardless of VAPID).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# (NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY is read as an older name for the same
# key when NEXT_PUBLIC_VAPID_PUBLIC_KEY is unset.)

# --- Monitoring (Sentry), optional -------------------------------------------
# Error reporting for the web app. Inlined at BUILD time. Blank DSN = Sentry
# fully disabled (no init, no network). The other values work like the API's
# SENTRY_ENVIRONMENT / SENTRY_RELEASE / SENTRY_TRACES_SAMPLE_RATE.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Optional, build-time only: uploads source maps to Sentry when ALL three are
# set. Never commit or expose to the browser.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Platform values mirrored from the API env. Inlined at BUILD time like the
# VAPID key above. They only drive UI hints (the protected admin row, the
# cPanel mailbox notes, the prefilled mail host); the API enforces the real
# rules. Blank: no hint.
#   NEXT_PUBLIC_ADMIN_EMAIL        the API's ADMIN_EMAIL
#   NEXT_PUBLIC_CPANEL_DOMAIN      the API's CPANEL_DOMAIN
#   NEXT_PUBLIC_MAIL_DEFAULT_HOST  the API's MAIL_DEFAULT_IMAP_HOST; prefilled as
#                                  both IMAP and SMTP host in Add mail account
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_CPANEL_DOMAIN=
NEXT_PUBLIC_MAIL_DEFAULT_HOST=

# --- Edge sign-in redirect, optional -----------------------------------------
# Inlined at BUILD time. "1" lets middleware send signed-out visits straight to
# /sign-in (and resolve `/`) before the app shell downloads, based on whether
# the session cookie is present. Only enable it when AUTH_COOKIE_DOMAIN (root
# .env) makes the session cookie visible to the web host; otherwise every
# signed-in visit bounces to /sign-in. Blank/0 = off, SessionGate handles it.
NEXT_PUBLIC_EDGE_AUTH_REDIRECT=
# Session cookie prefix the middleware looks for. MUST equal the API's
# AUTH_COOKIE_PREFIX (root .env). Blank = better-auth (the default prefix).
NEXT_PUBLIC_AUTH_COOKIE_PREFIX=

# --- Public forms bot check, optional ----------------------------------------
# Cloudflare Turnstile site key. Blank = no bot check widget on public forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
