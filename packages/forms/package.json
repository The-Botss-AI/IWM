{
  "name": "@botss/forms",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144\" tsc -p tsconfig.json",
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144\" tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "echo 'lint defers to root' && exit 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo || exit 0"
  },
  "dependencies": {
    "@botss/shared-types": "workspace:*",
    "libphonenumber-js": "^1.13.15",
    "re2js": "^2.9.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "vitest": "4.1.12"
  }
}
